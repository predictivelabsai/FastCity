# --- FastCity --------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit secrets.

FASTCITY_ADMIN_EMAIL=admin@fastcity.example
FASTCITY_ADMIN_PASSWORD=FastCity2026$
FASTCITY_SECRET=
FASTCITY_PORT=5011
FASTCITY_ENV_LABEL=FastCity
# Blank => ./fastcity.sqlite. In Docker point at the mounted volume.
FASTCITY_DB=

# --- AI assistant ----------------------------------------------------------
# Free-form chat uses one provider; slash-commands (/kpi, /devices …) need no key.
#   MODEL_PROVIDER: xai | openai | anthropic | google
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
